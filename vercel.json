{
  "compression": [
    {
      "source": "**/*.@(js|css|html|json|svg|xml|txt|md|ico|eot|ttf|woff|woff2|otf)",
      "gzip": true,
      "brotli": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Encoding",
          "value": "gzip"
        }
      ]
    }
  ]
}
